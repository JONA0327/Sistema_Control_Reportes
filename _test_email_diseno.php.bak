<?php
require __DIR__ . '/vendor/autoload.php';
$app = require __DIR__ . '/bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();

try {
    $user = \App\Models\User::where('email', 'jona03278@gmail.com')->first();
    if (! $user) {
        // Fall back to first user if jona03278 doesn't exist
        $user = \App\Models\User::first();
    }
    if (! $user) {
        // Create a fake user
        $user = new \App\Models\User([
            'name' => 'Jonathan',
            'email' => 'jona03278@gmail.com',
        ]);
        $user->exists = true;
    }

    \Illuminate\Support\Facades\Mail::to('jona03278@gmail.com')
        ->send(new \App\Mail\PasswordResetCodeMail($user, '482917'));

    echo "OK - Correo con diseno enviado a jona03278@gmail.com (usuario: {$user->name})" . PHP_EOL;
} catch (\Throwable $e) {
    echo "ERROR: " . $e->getMessage() . PHP_EOL;
    echo "Trace: " . $e->getTraceAsString() . PHP_EOL;
}
